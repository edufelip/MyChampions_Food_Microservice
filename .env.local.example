# Local MyChampions food API development.
# Copy to .env.local or export these values before running the dev script.

PORT=3201
NODE_ENV=development
LOG_LEVEL=debug

REDIS_URL=redis://localhost:16379
POSTGRES_URL=postgres://mychampions_local:mychampions_local_password@localhost:15432/mychampions_food_catalog_local
CATALOG_POSTGRES_RESTORE_ON_MISS=true

MYCHAMPIONS_AUTH_SERVER_URL=http://localhost:3400
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
GOOGLE_TRANSLATE_API_KEY=

# Optional: keep local startup cheap unless explicitly testing catalog ingestion.
ENABLE_STARTUP_CATALOG_SYNC=false
ENABLE_TRANSLATION_PIPELINE=false
